NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave exclusiva do servidor; nunca use o prefixo NEXT_PUBLIC_ aqui.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=15

# "supabase" (padrão) ou "s3" (AWS S3, Cloudflare R2, Backblaze B2,
# Wasabi, MinIO e outros provedores compatíveis).
STORAGE_PROVIDER=supabase
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
